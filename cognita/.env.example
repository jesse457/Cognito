APP_NAME=Cognita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (docker compose publishes Postgres on host port 5433)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=cognita
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@cognita.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Board PDF storage — S3-compatible MinIO (docker compose `minio` service)
# ---------------------------------------------------------------------------
# Start the storage backend first (`docker compose up -d minio minio-mc`).
# Set BOARDS_DISK=local (plus run `php artisan storage:mkdir`-style setup) to
# fall back to the local filesystem instead of object storage.
BOARDS_DISK=s3
AWS_ACCESS_KEY_ID=cognita
AWS_SECRET_ACCESS_KEY=cognita-minio-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cognita
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Realtime: group calls and the shared board
# ---------------------------------------------------------------------------
# Which adapter serves the call. The browser picks the matching client adapter
# from the same name; an unknown driver makes the app fail loudly at boot rather
# than half-work at join time. Add one in config/realtime.php.
REALTIME_DRIVER=livekit

# A class session stays open until the instructor presses End class. A lost
# network or a rejoin does not create a new session, and drawings stay with the
# session until the instructor starts a fresh board.

# --- LiveKit (the bundled adapter) ---------------------------------------
# Leave LIVEKIT_URL unset: the app tells every browser to dial the same host it
# used to load the page, so localhost, a phone on the LAN and a tunnel all work
# without editing .env. Set it only for hosted LiveKit (LIVEKIT_URL_MODE=fixed).
# LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL_MODE=auto
LIVEKIT_PORT=7880
LIVEKIT_SECURE_PORT=0      # 0 = follow the page (https page -> wss on its port)
LIVEKIT_TLS_PORT=8443      # where .dev/lan-forward serves the app over https
LIVEKIT_TURN_PORT=3478     # UDP media + STUN health probe
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me
LIVEKIT_TOKEN_TTL=3600
LIVEKIT_ROOM_PREFIX=cognita-class

# Read only by docker-compose.yml, never by the app. Leave it commented out:
# LiveKit then advertises its own interface address, which keeps working when
# this machine moves to another network. Pin it only if the container sits on a
# network whose address the browsers cannot reach.
# LIVEKIT_NODE_IP=192.168.1.20

# ---------------------------------------------------------------------------
# Semantic search (community questions and answers)
# ---------------------------------------------------------------------------
# Embeddings go through the Laravel AI SDK. Set OPENAI_API_KEY (or name a
# different configured AI provider here) to use hosted embeddings. Without a
# key the app uses a deterministic local vector, so search, similar threads and
# tests still work offline. Re-run `php artisan questions:embed --fresh` after
# changing provider or model.
OPENAI_API_KEY=
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=768
EMBEDDINGS_MAX_DISTANCE=0.82

# Local EmbeddingGemma through llama-server (start with
# .dev/embeddinggemma.ps1, then use these values). EMBEDDINGS_URL=auto finds
# the Windows host from WSL; use an explicit http://host:8081/v1 URL elsewhere.
# EMBEDDINGS_PROVIDER=openai-compatible
# EMBEDDINGS_MODEL=embeddinggemma-300m
# EMBEDDINGS_URL=auto
# EMBEDDINGS_PORT=8081
# EMBEDDINGS_KEY=
# EMBEDDINGS_QUERY_PREFIX=
# EMBEDDINGS_DOCUMENT_PREFIX=
